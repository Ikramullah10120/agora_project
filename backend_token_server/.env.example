# Backend Token Server Environment Configuration
# Copy to .env on your secure server and fill with your Agora credentials.
# NEVER commit the real .env file or share your App Certificate!

PORT=8080

# Agora App ID (from Agora Console)
AGORA_APP_ID=your_agora_app_id_here

# Agora Primary App Certificate (PRIVATE SECRET - KEEP ONLY ON BACKEND)
AGORA_APP_CERTIFICATE=your_agora_primary_app_certificate_here
