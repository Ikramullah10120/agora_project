# Agora Live Streaming Configuration
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file containing real secrets to version control!

# -----------------------------------------------------------------------------
# Agora RTC & Chat Configuration
# -----------------------------------------------------------------------------
# Agora App ID (from Agora Console -> Project Management)
AGORA_APP_ID=your_agora_app_id_here

# Agora Chat App Key (Format: <OrgName>#<AppName>)
AGORA_CHAT_APP_KEY=your_org_name#your_app_name

# Default User ID for testing / Chat login
AGORA_USER_ID=user1

# -----------------------------------------------------------------------------
# Development Tokens (Optional for local testing only)
# WARNING: In production, tokens expire (usually in 24 hours).
# Private App Certificates must NEVER be placed in a mobile app.
# Instead, point AGORA_TOKEN_SERVER_URL to your secure token backend.
# -----------------------------------------------------------------------------
AGORA_RTC_TOKEN=your_temporary_rtc_token_here
AGORA_CHAT_TOKEN=your_temporary_chat_token_here

# -----------------------------------------------------------------------------
# Secure Backend Token Server (RECOMMENDED FOR PRODUCTION)
# If provided, the app will dynamically fetch fresh RTC and Chat tokens from this server
# -----------------------------------------------------------------------------
AGORA_TOKEN_SERVER_URL=https://your-token-server.example.com
